<?xml version="1.0"?> 

<!-- The name="" is absent in the robot tag, meaning that this file is not 
     meant to be launched directly, but included in another .urdf.xacro -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="blue">
        <color rgba="0 0 0.5 1" />
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <material name="pink">
        <color rgba="1 0 0.5 1" />
    </material>

    <material name="orange">
        <color rgba="1 0.5 0 1" />
    </material>

    <material name="yellow">
        <color rgba="1 1 0 1" />
    </material>

    <!-- Writing a inertial macro for a box, this way any box can import/use this.
         Inertia tensor/matrix can be found in https://en.wikipedia.org/wiki/List_of_moments_of_inertia
         Notice that the diagonal elements in tensor use the two other elements,
         this allows us to not worry about what corresponds to what in width,
         depth, height and x,y,z -->
    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
            <mass value="${m}" />   <!-- mass in kg -->
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${(m/12) * (y*y + z*z)}"  ixy="0"                         ixz="0"
                                                    iyy="${(m/12) * (x*x + z*z)}"   iyz="0"
                                                                                    izz="${(m/12) * (x*x + y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r l o_xyz o_rpy">
        <inertial>
            <mass value="${m}" />
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${(m/12) * (3*r*r + l*l)}"  ixy="0"                            ixz="0"
                                                      iyy="${(m/12) * (3*r*r + l*l)}"    iyz="0"
                                                                                         izz="${(1/2)*m*r*r}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <mass value="${m}" />
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${(2/5) * m * r*r}"  ixy="0"                   ixz="0"
                                               iyy="${(2/5) * m * r*r}"  iyz="0"
                                                                         izz="${(2/5) * m * r*r}" />
        </inertial>
    </xacro:macro>

</robot>