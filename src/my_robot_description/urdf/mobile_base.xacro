<?xml version="1.0"?> 

<!-- The name="" is absent in the robot tag, meaning that this file is not 
     meant to be launched directly, but included in another .urdf.xacro -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


    <xacro:property name="base_length" value="0.6" />   <!-- we can define xacro variables/properties and access them with ${} -->
    <xacro:property name="base_width" value="0.4" />    <!-- variables defined with <let name="v1" value="10" /> are accessed with $(var v1) -->
    <xacro:property name="base_height" value="0.2" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" />

    <xacro:property name="box_mass" value="5.0" />
    <xacro:property name="wheel_mass" value="1.0" />
    <xacro:property name="caster_wheel_mass" value="0.5" />

  <!-- ################ LINKS ################ -->

    <link name="base_footprint" />   <!-- the convention is to omit "_link" in base_footprint name -->

    <link name="base_link">   <!-- the name "base_link" is good practice/mandatory -->
        
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />   <!-- length(x), width(y), heigh(z) in meters -->
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />   <!-- rpy stands for roll, pitch, yaw -->
            <material name="blue" />
        </visual>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="${box_mass}" x="${base_length}" y="${base_width}" z="${base_height}"
                           o_xyz="0 0 ${base_height / 2.0}" o_rpy="0 0 0" />

    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            <material name="grey" />
        </visual>

        <!-- In wheels, a cylinder collision shape will colide with the ground in a line (if perfect cylinder), therefore for
             wheels we make the collision shape a sphere such that there is only one point that is in contact with the ground -->
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_length}"
                                o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <xacro:sphere_inertia m="${caster_wheel_mass}" r="${wheel_radius / 2.0}" 
                              o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

  <!-- ################ JOINTS ################ -->

    <!-- Since the parent is base_footprint, then the base_link is 
         positioned wrt base_footprint -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="${-base_length / 4.0} ${-(base_width / 2.0 + wheel_length / 2.0)} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="${-base_length / 4.0} ${base_width / 2.0 + wheel_length / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${base_length / 3.0} 0 ${-wheel_radius / 2.0}" rpy="0 0 0" />
    </joint>

</robot>

<!--
  NOTES

    All links must be joined by joints, some people create links first then joints, others alternate,
    so some link-joint-link-joint-link, some link-link-link-joint-joint (this will be used here)

    When connecting the links, first set all link and joint origins to zero, then adjust base_link, 
    base_second_joint, second_link, second_third_joint, third_link, etc.

    Documentation can be found in https://wiki.ros.org/urdf/XML  especially for links and joints

    <origin> location    |  Relative to          |      Meaning
    <joint><origin>         parent link frame           Where the child/joint frame is
    <visual><origin>        current link frame          Where the visual geometry is

    One can overdo xacro:properties and xacro:macros.. It's about balace and using them whenever the
    need is evedent

    <collision> tags have the same content as the <visual> tags except that they lack <material>.
    If visual is a custom mesh, this is often simplified to get rid of unnecessary computation
    e.g. the turtlebot3_waffle has a box collision geometry.

    If a link doesn't show up in Gazebo then something is wrong with that link's <inertial> tag.

    If a link doesn't goes through the floor in Gazebo then something is wrong with that link's <collision> tag.

  IMPORTANT TRICKS/COMMANDS

    To find which lines have tabs use 
        grep -n $'\t' my_robot.urdf.xacro

    To replace tabs with 4 spaces in file use 
        sed -i 's/\t/    /g' robot.urdf.xacro

-->

<!-- 
  SECOND LINK WITH PRISMATIC JOINT

    <link name="second_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.2" />
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0" />
            <material name="grey" />
        </visual>
    </link>

    <joint name="base_second_joint" type="prismatic"> <!- convension for joint names is "parent_child_joint" ->
        <parent link="base_link" />
        <child link="second_link" />
        <origin xyz="0 0 0.2" rpy="0 0 0" />   <!- the joint origin is the most important and first adjustment, then one can readjust the (link) visual origin accordingly ->
        <axis xyz="1 0 0" />
        <limit lower="0.0" upper="0.2" velocity="100" effort="100" />
    </joint> 
    
-->

<!-- 
  THIRD LINK 

    <link name="third_link">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.1" />
            </geometry>
            <origin xyz="0 0 0.05" rpy="0 0 0" />
            <material name="blue" />
        </visual>
    </link>

    <joint name="second_third_joint" type="fixed">
        <parent link="second_link" />
        <child link="third_link" />
        <origin xyz="0 0 0.2" rpy="0 0 0" />
    </joint>
    
-->

<!-- 
  REVOLUTE JOINT
  CONTINUOUS JOINT is the same but without limits on its rotation, it can rotate indefinitely 

    <joint name="base_second_joint" type="revolute">
        <parent link="base_link" />
        <child link="second_link" />
        <origin xyz="0 0 0.2" rpy="0 0 0" />   <!- the joint origin is the most important and first adjustment, then one can readjust the (link) visual origin accordingly ->
        <axis xyz="0 0 1" />
        <limit lower="-1.57" upper="1.57" velocity="100" effort="100" />   <!- angles are in radians, 1.57 rad = 90 degrees ->
    </joint> 
    
-->

<!--
  MACRO SYNTAX

    <xacro:macro name="example_macro" params="a b c">
        <link name="dummy_link">
            <visual>
                <geometry>
                    <box size="${a} ${b} ${c}" />
                </geometry>
            </visual>
        </link>
    </xacro:macro>

    <xacro:example_macro a="2" b="3" c="4" />

-->

<!--
  HARD-CODED WHEEL LINKS

    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />   <!- we can access xacro features with ${}, pi already exists in xacro ->
            <material name="grey" />
        </visual>
    </link>

    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            <material name="grey" />
        </visual>
    </link>
-->